# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.md  
/MD

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which must carry names only and never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets and sensitive material — never relax these
*.pdf
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
google-services.json
GoogleService-Info.plist
serviceAccount*.json

# Data files whose names suggest they hold credentials. Scoped to data
# extensions on purpose: a bare `*secret*` would also swallow source files
# like SecretSection.tsx, and a silently untracked component is a nasty
# thing to debug.
*secret*.json
*secret*.txt
*secret*.yml
*secret*.yaml
*secrets*.js
*credential*.json
*credential*.txt
*credential*.yml
*credential*.yaml

# local agent notes
.claude/settings.local.json
Claude.md
Claude_log.txt
